{
  "extends": ["html-validate:recommended"],
  "rules": {
    "no-inline-style": "off",
    "tel-non-breaking": "off",
    "doctype-style": "off",
    "no-trailing-whitespace": "off",
    "long-title": "off",
    "no-autoplay": "off",
    "prefer-native-element": "off",
    "wcag/h37": "error",
    "wcag/h32": "error",
    "input-missing-label": "error",
    "unique-landmark": "error",
    "empty-heading": "error",
    "heading-level": "error"
  }
}
